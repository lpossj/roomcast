# 独立 server 默认仅监听本机；如需 Tailscale/局域网访问，显式设置 HOST=0.0.0.0 并限制防火墙访问范围。
PORT=3210
HOST=127.0.0.1
OBS_WEBSOCKET_PORT=4457
# 可选自建 TURN；留空时不使用此 TURN 配置；原生 P2P direct 仍可能使用默认公共 STUN。
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
# 仅直接公网部署需要可信证书。推荐在 Tailscale 私有网络内使用。
TLS_CERT=
TLS_KEY=
# 可选限制可创建房间的客户端；默认允许组网内用户创建。
ALLOWED_ORIGINS=
