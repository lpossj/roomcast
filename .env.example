# 独立 server 默认仅监听本机；如需 Tailscale/局域网访问，显式设置 HOST=0.0.0.0 并限制防火墙访问范围。
PORT=3210
HOST=127.0.0.1
OBS_WEBSOCKET_PORT=4457

# 可选：自建 PeerJS 信令服务器，例如 https://signal.example.com。
# 留空时使用 PeerJS 默认公共云信令。
PEER_SERVER_URL=

# 可选自建 TURN 静态凭据；留空时不使用此 TURN 配置；原生 P2P direct 仍可能使用默认公共 STUN。
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# 可选 Cloudflare TURN / 兼容 TURN 的短期凭据配置。
TURN_URLS=
TURN_SHARED_SECRET=

# 可选限制可创建房间的客户端；默认允许组网内用户创建。
SERVER_CREATE_KEY=
ALLOWED_ORIGINS=

# 仅直接公网部署需要可信证书。推荐在 Tailscale 私有网络内使用。
TLS_CERT=
TLS_KEY=