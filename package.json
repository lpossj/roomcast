{
  "name": "roomcast",
  "version": "0.14.1",
  "description": "同屏Roomcast屏幕共享工具",
  "author": "D4Y0 / Roomcast",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "server": "node server/index.mjs",
    "start": "electron .",
    "start:viewer": "node scripts/start-viewer.cjs",
    "start:viewer:clean": "node scripts/start-viewer.cjs --clean",
    "setup": "node scripts/setup.mjs",
    "test": "node --test tests/*.test.mjs",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --win portable",
    "dist:zip": "npm run build && electron-builder --win zip",
    "dist:nsis": "npm run build && electron-builder --win nsis",
    "check:network": "node scripts/check-network-architecture.mjs",
    "prepare:obs": "node scripts/prepare-embedded-obs.mjs",
    "prepare:obs:release": "node scripts/prepare-embedded-obs.mjs --release",
    "check:obs-bridge": "electron scripts/check-obs-electron-bridge.cjs",
    "check:obs-virtualcam-wait": "node scripts/check-obs-virtualcam-wait.cjs",
    "check:obs-transition": "electron scripts/check-obs-static-motion.cjs",
    "check:obs-transition-metrics": "node scripts/check-obs-transition-metrics.cjs",
    "check:obs-package": "node scripts/check-packaged-obs-step5d.cjs",
    "dist:obs-verified": "npm run dist && npm run check:obs-package"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@vdoninja/sdk": "1.6.1",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "44.3.0",
    "electron-builder": "^26.0.12",
    "playwright": "^1.58.2",
    "vite": "^7.3.0",
    "lucide-react": "^0.577.0",
    "peerjs": "^1.5.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "socket.io-client": "^4.8.1"
  },
  "build": {
    "appId": "local.roomcast.desktop",
    "productName": "Roomcast",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "server/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "runtime/obs-bundle",
        "to": "runtime/obs-bundle",
        "filter": [
          "**/*",
          "!config/**/*",
          "!config",
          "!**/*.pdb",
          "!obs-plugins/64bit/libcef.dll",
          "!obs-plugins/64bit/libGLESv2.dll",
          "!obs-plugins/64bit/libEGL.dll",
          "!obs-plugins/64bit/chrome_elf.dll",
          "!obs-plugins/64bit/icudtl.dat",
          "!obs-plugins/64bit/resources.pak",
          "!obs-plugins/64bit/chrome_100_percent.pak",
          "!obs-plugins/64bit/chrome_200_percent.pak",
          "!obs-plugins/64bit/v8_context_snapshot.bin",
          "!obs-plugins/64bit/obs-browser.dll",
          "!obs-plugins/64bit/obs-browser-page.exe",
          "!obs-plugins/64bit/locales/**/*",
          "!data/obs-plugins/obs-browser/**/*"
        ]
      },
      {
        "from": "runtime/obs-source",
        "to": "runtime/obs-source",
        "filter": [
          "OBS-Studio-32.1.2-Sources.tar.gz",
          "OBS-SOURCE-NOTICE.txt"
        ]
      },
      {
        "from": "runtime/loopback-capture",
        "to": "runtime/loopback-capture",
        "filter": [
          "loopback_capture_addon.node",
          "LICENSE"
        ]
      },
      {
        "from": "LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "NOTICE",
        "to": "NOTICE"
      },
      {
        "from": "SECURITY.md",
        "to": "SECURITY.md"
      },
      {
        "from": "PRIVACY.md",
        "to": "PRIVACY.md"
      },
      {
        "from": "TRADEMARKS.md",
        "to": "TRADEMARKS.md"
      },
      {
        "from": "ACCEPTABLE_USE.md",
        "to": "ACCEPTABLE_USE.md"
      },
      {
        "from": "CODE_OF_CONDUCT.md",
        "to": "CODE_OF_CONDUCT.md"
      },
      {
        "from": "CONTRIBUTING.md",
        "to": "CONTRIBUTING.md"
      },
      {
        "from": "THIRD-PARTY-NOTICES.txt",
        "to": "THIRD-PARTY-NOTICES.txt"
      }
    ],
    "win": {
      "artifactName": "Roomcast-${version}-Windows.${ext}",
      "target": "portable",
      "signExecutable": false,
      "requestedExecutionLevel": "asInvoker",
      "icon": "build-assets/roomcast-icon.ico"
    },
    "portable": {
      "artifactName": "Roomcast-${version}-Windows.exe"
    },
    "nsis": {
      "artifactName": "Roomcast-${version}-Setup.exe",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build-assets/roomcast-icon.ico",
      "uninstallerIcon": "build-assets/roomcast-icon.ico",
      "installerHeaderIcon": "build-assets/roomcast-icon.ico"
    },
    "protocols": [
      {
        "name": "Roomcast Invite",
        "schemes": [
          "roomcast"
        ]
      }
    ],
    "beforePack": "./scripts/before-pack.cjs",
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    },
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "copyright": "Copyright (c) 2026 D4Y0 / Roomcast"
  }
}
